            "path": "/bounces",
            "status_code": 200,
            "headers": {
              "Content-Type": "application/json",
              "X-RateLimit-Remaining": "{{integer}}"
            },
            "delay_ms": 0,
            "response": {
              "data": [
                {
                  "bounce_id": "{{uuid}}",
                  "message_id": "{{uuid}}",
                  "email": "{{email}}",
                  "bounce_type": "hard",
                  "bounce_code": "550",
