                  "mx_server": "{{ipv4}}",
                  "occurred_at": "{{isodate}}"
                },
                {
                  "bounce_id": "{{uuid}}",
                  "message_id": "{{uuid}}",
                  "email": "{{email}}",
                  "bounce_type": "soft",
                  "bounce_code": "452",
                  "diagnostic": "452 4.2.2 Mailbox full. Try again later.",
                  "mx_server": "{{ipv4}}",
                  "occurred_at": "{{isodate}}"
                },
                {
                  "bounce_id": "{{uuid}}",
                  "message_id": "{{uuid}}",
                  "email": "{{email}}",
                  "bounce_type": "hard",
                  "bounce_code": "550",
                  "diagnostic": "550 5.1.2 Bad destination mailbox address.",
                  "mx_server": "{{ipv4}}",
                  "occurred_at": "{{isodate}}"
                }
              ],
              "pagination": {
                "page": 1,
                "per_page": 50,
                "total_items": 127,
                "total_pages": 3
              }
            }
          },
          {
            "name": "List Unsubscribes",
            "method": "GET",
            "path": "/unsubscribes",
            "status_code": 200,
            "headers": {
              "Content-Type": "application/json",
              "X-RateLimit-Remaining": "{{integer}}"
            },
            "delay_ms": 0,
            "response": {
              "data": [
                {
                  "unsubscribe_id": "{{uuid}}",
