{
  "name": "Email Service API",
  "description": "Send email, templates, delivery status, bounces, unsubscribes, webhooks",
  "import_to_mockhub": "https://mockhub.ovh/api-generator/generate_api.html",
  "endpoints": [
    {
      "name": "Send Email",
      "method": "POST",
      "path": "/emails/send",
      "status_code": 202,
      "headers": {
        "Content-Type": "application/json",
        "X-Request-Id": "{{uuid}}"
      },
      "delay_ms": 250,
      "response": {
        "message_id": "{{uuid}}",
        "status": "queued",
        "from": "noreply@{{company}}.com",
        "to": [
          "{{email}}"
        ],
        "cc": [],
        "bcc": [],
        "subject": "{{sentence}}",
        "content_type": "text/html",
        "priority": "normal",
        "tags": [
          "{{word}}",
          "{{word}}"
        ],
        "metadata": {
          "campaign_id": "{{uuid}}",
          "source": "{{word}}"
        },
        "queued_at": "{{isodate}}",
        "estimated_delivery": "{{isodate}}"
      }
    },
    {
      "name": "Send Email - Invalid Recipient",
      "method": "POST",
      "path": "/emails/send",
      "status_code": 422,
      "headers": {
        "Content-Type": "application/json",
        "X-Request-Id": "{{uuid}}"
      },
      "delay_ms": 100,
      "response": {
        "error": {
          "code": "INVALID_RECIPIENT",
          "message": "One or more recipient email addresses are invalid or malformed.",
          "details": [
            {
              "field": "to[0]",
              "value": "not-an-email",
              "reason": "Invalid email format. Expected format: user@domain.tld"
            }
          ],
          "request_id": "{{uuid}}",
          "timestamp": "{{isodate}}"
        }
      }
    },
    {
      "name": "Get Email Delivery Status",
      "method": "GET",
      "path": "/emails/:message_id/status",
      "status_code": 200,
      "headers": {
        "Content-Type": "application/json",
        "X-RateLimit-Remaining": "{{integer}}"
      },
      "delay_ms": 0,
      "response": {
        "message_id": "{{uuid}}",
        "status": "delivered",
        "from": "noreply@{{company}}.com",
        "to": "{{email}}",
        "subject": "{{sentence}}",
        "events": [
          {
            "event": "queued",
            "timestamp": "{{isodate}}",
            "details": null
          },
          {
            "event": "sent",
            "timestamp": "{{isodate}}",
            "details": {
              "smtp_response": "250 OK",
              "server": "{{ipv4}}"
            }
          },
          {
            "event": "delivered",
            "timestamp": "{{isodate}}",
            "details": {
              "mx_host": "mx1.{{word}}.com",
              "delivery_time_ms": [
                [
                  "integer}}\n            }\n          }",
                  {
                    "event": "opened",
                    "timestamp": "{{isodate}}",
                    "details": {
                      "user_agent": "Mozilla/5.0",
                      "ip_address": "{{ipv4}}",
                      "city": "{{city}}",
                      "country": "{{country}}"
                    }
                  }
                ],
                {
                  "open_count": 3,
                  "click_count": 1,
                  "created_at": "{{isodate}}",
                  "updated_at": "{{isodate}}"
                }
              ],
              "name": "Get Email Delivery Status - Not Found",
              "method": "GET",
              "path": "/emails/:message_id/status",
              "status_code": 404,
              "headers": {
                "Content-Type": "application/json"
              },
              "delay_ms": 0,
              "response": {
                "error": {
                  "code": "MESSAGE_NOT_FOUND",
                  "message": "No email message found with the provided message_id.",
                  "request_id": "{{uuid}}",
                  "timestamp": "{{isodate}}"
                }
              }
            },
            "name": "List Email Templates",
            "method": "GET",
            "path": "/templates",
            "status_code": 200,
            "headers": {
              "Content-Type": "application/json",
              "X-RateLimit-Remaining": "{{integer}}"
            },
            "delay_ms": 0,
            "response": {
              "data": [
                {
                  "template_id": "{{uuid}}",
                  "name": "Welcome Email",
                  "slug": "welcome-email",
                  "subject": "Welcome to {{company}}!",
                  "content_type": "text/html",
                  "version": 3,
                  "active": true,
                  "tags": [
                    "onboarding",
                    "welcome"
                  ],
                  "created_by": "{{email}}",
                  "created_at": "{{isodate}}",
                  "updated_at": "{{isodate}}"
                },
                {
                  "template_id": "{{uuid}}",
                  "name": "Password Reset",
                  "slug": "password-reset",
                  "subject": "Reset your password",
                  "content_type": "text/html",
                  "version": 1,
                  "active": true,
                  "tags": [
                    "security",
                    "transactional"
                  ],
                  "created_by": "{{email}}",
                  "created_at": "{{isodate}}",
                  "updated_at": "{{isodate}}"
                },
                {
                  "template_id": "{{uuid}}",
                  "name": "Monthly Newsletter",
                  "slug": "monthly-newsletter",
                  "subject": "{{company}} Monthly Update - {{word}}",
                  "content_type": "text/html",
                  "version": 12,
                  "active": true,
                  "tags": [
                    "marketing",
                    "newsletter"
                  ],
                  "created_by": "{{email}}",
                  "created_at": "{{isodate}}",
                  "updated_at": "{{isodate}}"
                }
              ],
              "pagination": {
                "page": 1,
                "per_page": 25,
                "total_items": 3,
                "total_pages": 1
              }
            }
          },
          {
            "name": "Create Email Template",
            "method": "POST",
            "path": "/templates",
            "status_code": 201,
            "headers": {
              "Content-Type": "application/json",
              "Location": "/templates/{{uuid}}"
            },
            "delay_ms": 200,
            "response": {
              "template_id": "{{uuid}}",
              "name": "{{word}} Notification",
              "slug": "{{word}}-notification",
              "subject": "{{sentence}}",
              "html_body": "<html><body><h1>Hello {{firstname}}</h1><p>{{sentence}}</p></body></html>",
              "text_body": "Hello {{firstname}}, {{sentence}}",
              "content_type": "text/html",
              "variables": [
                "first_name",
                "action_url",
                "company_name"
              ],
              "version": 1,
              "active": true,
              "created_by": "{{email}}",
              "created_at": "{{isodate}}",
              "updated_at": "{{isodate}}"
            }
          },
          {
            "name": "Update Email Template",
            "method": "PUT",
            "path": "/templates/:template_id",
            "status_code": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "delay_ms": 180,
            "response": {
              "template_id": "{{uuid}}",
              "name": "Updated {{word}} Template",
              "slug": "updated-{{word}}-template",
              "subject": "{{sentence}}",
              "html_body": "<html><body><h1>Updated Content</h1><p>{{sentence}}</p></body></html>",
              "text_body": "Updated: {{sentence}}",
              "content_type": "text/html",
              "variables": [
                "first_name",
                "action_url",
                "company_name",
                "unsubscribe_url"
              ],
              "version": 4,
              "active": true,
              "created_by": "{{email}}",
              "updated_by": "{{email}}",
              "created_at": "{{isodate}}",
              "updated_at": "{{isodate}}"
            }
          },
          {
            "name": "Delete Email Template",
            "method": "DELETE",
            "path": "/templates/:template_id",
            "status_code": 204,
            "headers": {
              "Content-Type": "application/json",
              "X-Request-Id": "{{uuid}}"
            },
            "delay_ms": 150,
            "response": {}
          },
          {
            "name": "List Bounces",
