                }
              ],
              "pagination": {
                "page": 1,
                "per_page": 50,
                "total_items": 89,
                "total_pages": 2
              }
            }
          },
          {
            "name": "Add to Unsubscribe List",
            "method": "POST",
            "path": "/unsubscribes",
            "status_code": 201,
            "headers": {
              "Content-Type": "application/json"
            },
            "delay_ms": 120,
            "response": {
              "unsubscribe_id": "{{uuid}}",
              "email": "{{email}}",
              "reason": "Manual addition by administrator",
              "source": "api",
              "added_by": "{{email}}",
              "created_at": "{{isodate}}"
            }
          },
          {
            "name": "Remove from Unsubscribe List",
            "method": "DELETE",
            "path": "/unsubscribes/:unsubscribe_id",
            "status_code": 204,
            "headers": {
              "Content-Type": "application/json",
              "X-Request-Id": "{{uuid}}"
            },
            "delay_ms": 100,
            "response": {}
          },
