                "event_type": "delivered",
                "message_id": "{{uuid}}",
                "email": "{{email}}",
                "timestamp": "{{isodate}}"
              },
              "result": {
                "success": true,
                "http_status": 200,
                "response_time_ms": 142,
                "response_body": "{\"received\":true}"
              },
              "tested_at": "{{isodate}}"
            }
          },
          {
            "name": "Send Email - Rate Limit Exceeded",
            "method": "POST",
            "path": "/emails/send",
            "status_code": 429,
            "headers": {
              "Content-Type": "application/json",
              "Retry-After": "60",
              "X-RateLimit-Limit": "1000",
              "X-RateLimit-Remaining": "0",
              "X-RateLimit-Reset": "{{timestamp}}"
            },
            "delay_ms": 80,
            "response": {
              "error": {
                "code": "RATE_LIMIT_EXCEEDED",
                "message": "You have exceeded the maximum number of email sends per minute. Please wait before retrying.",
                "limit": 1000,
                "remaining": 0,
                "reset_at": "{{isodate}}",
                "retry_after_seconds": 60,
                "request_id": "{{uuid}}",
                "timestamp": "{{isodate}}"
              }
            }
          },
          {
            "name": "Unauthorized Access",
            "method": "GET",
            "path": "/emails/:message_id/status",
            "status_code": 401,
            "headers": {
              "Content-Type": "application/json",
              "WWW-Authenticate": "Bearer"
            },
            "delay_ms": 0,
            "response": {
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Invalid or missing API key. Please include a valid API key in the Authorization header.",
                "hint": "Use header: Authorization: Bearer your-api-key",
                "docs_url": "https://docs.emailservice.com/authentication",
                "request_id": "{{uuid}}",
                "timestamp": "{{isodate}}"
              }
            }
          },
          {
            "name": "Internal Server Error - Email Send Failure",
            "method": "POST",
            "path": "/emails/send",
            "status_code": 500,
            "headers": {
              "Content-Type": "application/json",
              "X-Request-Id": "{{uuid}}"
            },
            "delay_ms": 300,
            "response": {
              "error": {
                "code": "INTERNAL_ERROR",
